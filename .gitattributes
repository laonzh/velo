# Normalize text files to LF in the repository; Windows scripts stay CRLF in the working tree.
* text=auto

*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.slnx text
*.json text
*.md text
*.svg text
*.css text
*.js text
*.html text
*.gitignore text
*.editorconfig text
*.sh text
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.ico binary
*.woff binary
*.woff2 binary
